{
  "firestore": { "rules": "firestore.rules", "indexes": "firestore.indexes.json" },
  "functions": { "source": "functions" },
  "hosting": {
    "public": ".",
    "predeploy": ["node scripts/verify-hosting.cjs"],
    "ignore": ["firebase.json", ".firebaserc", ".git", ".git/**", "**/.*", "**/node_modules/**", "functions/**", "tests/**", "scripts/**", "*.md", "package*.json", "firestore.rules", "firestore.indexes.json", "*-debug.log"],
    "headers": [
      {"source":"/index.html","headers":[{"key":"Cache-Control","value":"no-cache, no-store, must-revalidate"}]},
      {"source":"/service-worker.js","headers":[{"key":"Cache-Control","value":"no-cache, no-store, must-revalidate"}]}
    ]
  },
  "emulators": { "auth": { "port": 9099 }, "firestore": { "port": 8088 }, "ui": { "enabled": false } }
}
