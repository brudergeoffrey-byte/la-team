{
  "name": "la-team",
  "private": true,
  "scripts": {
    "test": "for f in tests/*.test.js; do case \"$f\" in *firestore-rules-emulator*) continue;; esac; node \"$f\" || exit 1; done",
    "test:rules": "firebase emulators:exec --only firestore --project demo-la-team \"node tests/firestore-rules-emulator.test.js\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.18.0",
    "firebase-tools": "15.28.2"
  }
}
