rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isValidCode(code) {
      return code.matches('^([ABCDEFGHJKLMNPQRSTUVWXYZ23456789]{4}|[ABCDEFGHJKLMNPQRSTUVWXYZ23456789]{8})$');
    }

    function signedIn() { return request.auth != null; }
    function memberPath(clubId) { return /databases/$(database)/documents/clubs/$(clubId)/members/$(request.auth.uid); }
    function activeMember(clubId) {
      return signedIn() && exists(memberPath(clubId)) && get(memberPath(clubId)).data.status == 'active'
        && get(memberPath(clubId)).data.role in ['owner', 'admin', 'organizer'];
    }
    function clubAdmin(clubId) {
      return activeMember(clubId) && get(memberPath(clubId)).data.role in ['owner', 'admin'];
    }
    function clubOwner(clubId) {
      return activeMember(clubId) && get(memberPath(clubId)).data.role == 'owner';
    }
    function registeredAccount() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schemaVersion == 2
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.playerId is string;
    }
    function currentPlayerId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.playerId;
    }
    function registeredClubPlayer(clubId) {
      return registeredAccount()
        && exists(/databases/$(database)/documents/clubs/$(clubId)/players/$(currentPlayerId()))
        && get(/databases/$(database)/documents/clubs/$(clubId)/players/$(currentPlayerId())).data.membershipStatus == 'active';
    }
    function ownsLinkedPlayer(data) {
      return !data.keys().hasAny(['playerId'])
        || (existsAfter(/databases/$(database)/documents/players/$(data.playerId))
          && getAfter(/databases/$(database)/documents/players/$(data.playerId)).data.ownerUid == request.auth.uid);
    }

    function hasCommonPublicShape(data, code) {
      return data.code == code
        && data.ownerUid is string
        && data.ownerUid.size() > 0
        && data.revision is int
        && data.revision >= 1
        && data.updatedAt is int
        && data.status in ['live', 'finished']
        && data.mode in ['americano', 'ladder']
        && data.roundNumber is int
        && data.roundNumber >= 1
        && data.maxPoints is int
        && data.maxPoints >= 1
        && data.maxPoints <= 31
        && data.players is list
        && data.players.size() >= 4
        && data.players.size() <= 32
        && data.currentRound is map
        && data.ranking is list
        && data.ranking.size() == data.players.size()
        && data.previousResults is list;
    }

    function hasLegacyPublicShape(data, code) {
      return data.keys().hasOnly([
          'schemaVersion', 'code', 'ownerUid', 'revision', 'updatedAt',
          'status', 'mode', 'roundNumber', 'maxPoints', 'players',
          'currentRound', 'ranking', 'previousResults'
        ])
        && data.schemaVersion == 1
        && hasCommonPublicShape(data, code);
    }

    function hasTimedPublicShape(data, code) {
      return data.keys().hasOnly([
          'schemaVersion', 'code', 'ownerUid', 'revision', 'updatedAt',
          'status', 'mode', 'roundNumber', 'maxPoints', 'endMode',
          'roundDurationMinutes', 'roundEndsAt', 'players', 'currentRound',
          'ranking', 'previousResults'
        ])
        && data.schemaVersion == 2
        && data.endMode in ['points', 'time']
        && (data.endMode == 'points' || (
          data.roundDurationMinutes is int
          && data.roundDurationMinutes >= 1
          && data.roundDurationMinutes <= 180
          && data.roundEndsAt is int
          && data.roundEndsAt > 0
        ))
        && hasCommonPublicShape(data, code);
    }

    function hasCourtTimerPublicShape(data, code) {
      return data.keys().hasOnly([
          'schemaVersion', 'code', 'ownerUid', 'revision', 'updatedAt',
          'status', 'mode', 'roundNumber', 'maxPoints', 'endMode',
          'roundDurationMinutes', 'players', 'currentRound', 'ranking',
          'previousResults'
        ])
        && data.schemaVersion == 3
        && data.endMode in ['points', 'time']
        && (data.endMode == 'points' || (
          data.roundDurationMinutes is int
          && data.roundDurationMinutes >= 1
          && data.roundDurationMinutes <= 180
        ))
        && hasCommonPublicShape(data, code);
    }

    function hasClubPublicShape(data, code) {
      return data.keys().hasOnly([
          'schemaVersion', 'code', 'clubId', 'ownerUid', 'revision', 'updatedAt',
          'status', 'mode', 'roundNumber', 'maxPoints', 'endMode',
          'roundDurationMinutes', 'players', 'currentRound', 'ranking',
          'previousResults'
        ])
        && data.schemaVersion == 4
        && data.clubId is string
        && data.clubId.size() >= 4
        && data.endMode in ['points', 'time']
        && (data.endMode == 'points' || (
          data.roundDurationMinutes is int
          && data.roundDurationMinutes >= 1
          && data.roundDurationMinutes <= 180
        ))
        && hasCommonPublicShape(data, code);
    }

    function hasV2ClubPublicShape(data, code) {
      return data.keys().hasOnly([
          'schemaVersion', 'code', 'clubId', 'ownerUid', 'revision', 'updatedAt',
          'status', 'mode', 'roundNumber', 'maxPoints', 'endMode',
          'roundDurationMinutes', 'players', 'participantIds', 'currentRound', 'ranking',
          'previousResults'
        ])
        && data.schemaVersion == 5
        && data.clubId is string && data.clubId.size() >= 4
        && data.participantIds is list && data.participantIds.size() == data.players.size()
        && data.endMode in ['points', 'time']
        && (data.endMode == 'points' || (data.roundDurationMinutes is int
          && data.roundDurationMinutes >= 1 && data.roundDurationMinutes <= 180))
        && hasCommonPublicShape(data, code);
    }

    function hasValidPublicShape(data, code) {
      return hasLegacyPublicShape(data, code)
        || hasTimedPublicShape(data, code)
        || hasCourtTimerPublicShape(data, code)
        || hasClubPublicShape(data, code)
        || hasV2ClubPublicShape(data, code);
    }

    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['schemaVersion','email','displayName','defaultClubId','playerId','createdAt','updatedAt'])
        && request.resource.data.schemaVersion in [1, 2]
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.defaultClubId is string
        && ownsLinkedPlayer(request.resource.data);
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['schemaVersion','displayName','defaultClubId','playerId','updatedAt'])
        && request.resource.data.schemaVersion >= resource.data.schemaVersion
        && request.resource.data.schemaVersion <= 2
        && request.resource.data.email == resource.data.email
        && (!resource.data.keys().hasAny(['playerId']) || request.resource.data.playerId == resource.data.playerId)
        && ownsLinkedPlayer(request.resource.data);
      allow delete: if false;
    }

    match /players/{playerId} {
      function validPlayer(data) {
        return data.keys().hasOnly(['schemaVersion','playerId','publicId','ownerUid','displayName','normalizedName','status','createdAt','updatedAt'])
          && data.schemaVersion == 2 && data.playerId == playerId
          && data.publicId.matches('^LT-[ABCDEFGHJKLMNPQRSTUVWXYZ23456789]{4}$')
          && data.ownerUid is string && data.displayName is string
          && data.normalizedName is string && data.status in ['active','disabled'];
      }
      allow get: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow list: if false;
      allow create: if signedIn() && validPlayer(request.resource.data)
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid
        && validPlayer(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','normalizedName','updatedAt']);
      allow delete: if false;
    }

    match /clubs/{clubId} {
      allow get: if activeMember(clubId);
      allow list: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['schemaVersion','clubId','name','ownerUid','memberUids','status','plan','subscriptionStatus','trialEndsAt','billingCustomerId','createdAt','updatedAt'])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.clubId == clubId
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.status == 'active'
        && (!request.resource.data.keys().hasAny(['plan']) || request.resource.data.plan == 'free')
        && (!request.resource.data.keys().hasAny(['subscriptionStatus']) || request.resource.data.subscriptionStatus == 'inactive')
        && (!request.resource.data.keys().hasAny(['trialEndsAt']) || request.resource.data.trialEndsAt == null)
        && (!request.resource.data.keys().hasAny(['billingCustomerId']) || request.resource.data.billingCustomerId == null);
      allow update: if clubAdmin(clubId)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.clubId == resource.data.clubId
        && request.resource.data.schemaVersion == resource.data.schemaVersion
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','memberUids','status','updatedAt']);
      allow delete: if clubOwner(clubId);

      match /members/{uid} {
        function validMember(data) {
          return data.keys().hasOnly(['schemaVersion','uid','role','email','status','createdAt','updatedAt'])
            && data.schemaVersion == 1 && data.uid == uid
            && data.role in ['owner','admin','organizer']
            && data.status in ['active','invited','disabled'];
        }
        allow get, list: if activeMember(clubId);
        allow create: if validMember(request.resource.data) && (
          (uid == request.auth.uid
            && request.resource.data.role == 'owner'
            && getAfter(/databases/$(database)/documents/clubs/$(clubId)).data.ownerUid == request.auth.uid)
          || (clubOwner(clubId) && request.resource.data.role in ['admin','organizer'])
          || (clubAdmin(clubId) && !clubOwner(clubId) && request.resource.data.role == 'organizer'));
        allow update: if validMember(request.resource.data)
          && request.resource.data.uid == resource.data.uid
          && ((clubOwner(clubId) && uid != request.auth.uid)
            || (clubAdmin(clubId) && !clubOwner(clubId)
              && resource.data.role == 'organizer' && request.resource.data.role == 'organizer'));
        allow delete: if (clubOwner(clubId) && uid != request.auth.uid)
          || (clubAdmin(clubId) && !clubOwner(clubId) && resource.data.role == 'organizer');
      }

      match /players/{playerId} {
        function validClubPlayer(data) {
          return data.keys().hasOnly(['schemaVersion','clubId','playerId','ownerUid','displayName','normalizedName','membershipStatus','joinedAt','updatedAt'])
            && data.schemaVersion == 2 && data.clubId == clubId && data.playerId == playerId
            && data.ownerUid is string && data.displayName is string && data.normalizedName is string
            && data.membershipStatus in ['active','disabled'];
        }
        allow get: if activeMember(clubId)
          || (registeredAccount() && currentPlayerId() == playerId && resource.data.ownerUid == request.auth.uid);
        allow list: if activeMember(clubId);
        allow create: if clubAdmin(clubId) && validClubPlayer(request.resource.data)
          && exists(/databases/$(database)/documents/players/$(playerId))
          && get(/databases/$(database)/documents/players/$(playerId)).data.ownerUid == request.resource.data.ownerUid;
        allow update: if clubAdmin(clubId) && validClubPlayer(request.resource.data)
          && request.resource.data.clubId == resource.data.clubId
          && request.resource.data.playerId == resource.data.playerId
          && request.resource.data.ownerUid == resource.data.ownerUid;
        allow delete: if clubAdmin(clubId);
      }

      match /seasons/{seasonId} {
        function validScoring(data) {
          return data.keys().hasOnly(['scoringVersion','winPoints','lossPoints','minimumMatches','primary','tieBreakers'])
            && data.scoringVersion == 1
            && data.winPoints is int && data.lossPoints is int
            && data.winPoints > data.lossPoints && data.lossPoints >= 0
            && data.minimumMatches is int && data.minimumMatches >= 0
            && data.primary == 'averageChampionshipPoints'
            && data.tieBreakers == ['championshipPoints','averageDifference','wins'];
        }
        function validSeason(data) {
          return data.keys().hasOnly(['schemaVersion','seasonId','clubId','name','label','startsAt','endsAt','timezone','status','scoring','scoringVersion','createdAt','updatedAt'])
            && data.schemaVersion == 2 && data.seasonId == seasonId && data.clubId == clubId
            && data.name is string && data.startsAt is int && data.endsAt is int && data.endsAt > data.startsAt
            && data.status in ['draft','active','finished'] && data.scoringVersion == 1
            && validScoring(data.scoring) && data.scoring.scoringVersion == data.scoringVersion;
        }
        allow read: if activeMember(clubId) || registeredClubPlayer(clubId);
        allow create: if clubAdmin(clubId) && validSeason(request.resource.data);
        allow update: if clubAdmin(clubId) && validSeason(request.resource.data)
          && request.resource.data.clubId == resource.data.clubId
          && request.resource.data.seasonId == resource.data.seasonId
          && (resource.data.status == 'draft'
            || (request.resource.data.scoring == resource.data.scoring
              && request.resource.data.scoringVersion == resource.data.scoringVersion));
        allow delete: if clubOwner(clubId) && resource.data.status == 'draft';

        match /standings/{playerId} {
          allow get: if activeMember(clubId)
            || (registeredAccount() && currentPlayerId() == playerId);
          allow list: if activeMember(clubId) || registeredClubPlayer(clubId);
          // Une fonction serveur Admin est la seule source des statistiques officielles.
          allow create, update, delete: if false;
        }
      }

      match /events/{eventId} {
        function validEvent(data) {
          return data.keys().hasOnly(['schemaVersion','eventId','clubId','seasonId','tournamentId','competitionType','name','startsAt','plannedEndsAt','actualEndedAt','timezone','capacity','registrationStatus','status','createdAt','updatedAt'])
            && data.schemaVersion == 2 && data.eventId == eventId && data.clubId == clubId
            && data.name is string && data.startsAt is int && data.capacity is int
            && data.capacity >= 4 && data.capacity <= 256
            && data.competitionType in ['friendly','championship']
            && ((data.competitionType == 'friendly' && data.seasonId == null)
              || (data.competitionType == 'championship' && data.seasonId is string))
            && data.registrationStatus in ['open','closed']
            && data.status in ['draft','registration','live','finished'];
        }
        allow read: if activeMember(clubId) || registeredClubPlayer(clubId);
        allow create: if activeMember(clubId) && validEvent(request.resource.data);
        allow update: if activeMember(clubId) && validEvent(request.resource.data)
          && request.resource.data.clubId == resource.data.clubId
          && request.resource.data.eventId == resource.data.eventId;
        allow delete: if clubAdmin(clubId) && resource.data.status == 'draft';

        match /registrations/{registrationId} {
          function validRegistration(data) {
            return data.keys().hasOnly(['schemaVersion','registrationId','eventId','clubId','type','playerId','displayName','normalizedName','status','linkedPlayerId','linkedByUid','linkedAt','registeredByUid','createdAt','updatedAt'])
              && data.schemaVersion == 2 && data.registrationId == registrationId
              && data.eventId == eventId && data.clubId == clubId
              && data.type in ['registered','guest']
              && data.status in ['registered','waiting','cancelled'];
          }
          function ownRegistration(data) {
            return registeredAccount() && data.type == 'registered'
              && data.playerId == currentPlayerId() && data.registeredByUid == request.auth.uid;
          }
          allow get: if activeMember(clubId) || ownRegistration(resource.data);
          allow list: if activeMember(clubId);
          // Création, capacité/liste d'attente, désinscription et rattachement explicite
          // passent par des fonctions transactionnelles. Les clients ne contournent
          // jamais ces invariants en écrivant directement.
          allow create, update, delete: if false;
        }

        // Réservations commerciales et paiements sont exclusivement pilotés par
        // les fonctions serveur. Même un owner ne peut pas fabriquer un paiement.
        match /reservations/{reservationId} {
          allow get: if activeMember(clubId)
            || (registeredAccount() && resource.data.uid == request.auth.uid);
          allow list: if activeMember(clubId);
          allow create, update, delete: if false;
        }
        match /paymentAttempts/{paymentId} {
          allow read, create, update, delete: if false;
        }
        match /webhookEvents/{webhookId} {
          allow read, create, update, delete: if false;
        }

        match /participants/{participantId} {
          function validParticipant(data) {
            return data.keys().hasOnly(['schemaVersion','participantId','registrationId','playerId','displayNameSnapshot','type','engineIndex'])
              && data.schemaVersion == 2 && data.participantId == participantId
              && data.registrationId is string && data.displayNameSnapshot is string
              && data.type in ['registered','guest'] && data.engineIndex is int && data.engineIndex >= 0
              && ((data.type == 'registered' && data.playerId is string)
                || (data.type == 'guest' && data.playerId == null));
          }
          allow read: if activeMember(clubId)
            || (registeredAccount() && resource.data.playerId == currentPlayerId());
          allow create, update, delete: if activeMember(clubId)
            && validParticipant(request.resource.data);
        }
      }

      match /tournaments/{tournamentId} {
        function validPrivate(data) {
          return ((data.schemaVersion == 1
              && data.keys().hasOnly(['schemaVersion','tournamentId','clubId','ownerUid','createdByUid','publicCode','status','roundNumber','updatedAt','state']))
            || (data.schemaVersion == 2
              && data.keys().hasOnly(['schemaVersion','tournamentId','clubId','ownerUid','createdByUid','publicCode','eventId','seasonId','competitionType','status','roundNumber','updatedAt','state'])
              && data.competitionType in ['friendly','championship']
              && ((data.competitionType == 'friendly' && data.seasonId == null)
                || (data.competitionType == 'championship' && data.seasonId is string))))
            && data.tournamentId == tournamentId
            && data.clubId == clubId && data.ownerUid == get(/databases/$(database)/documents/clubs/$(clubId)).data.ownerUid
            && data.createdByUid is string && data.status in ['live','finished']
            && data.roundNumber is int && data.roundNumber >= 1 && data.state is map;
        }
        allow read: if activeMember(clubId);
        allow create: if activeMember(clubId) && validPrivate(request.resource.data)
          && request.resource.data.createdByUid == request.auth.uid;
        allow update: if activeMember(clubId) && validPrivate(request.resource.data)
          && request.resource.data.clubId == resource.data.clubId
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.createdByUid == resource.data.createdByUid;
        allow delete: if clubAdmin(clubId);

        match /matches/{matchId} {
          function validOfficialMatch(data) {
            return data.keys().hasOnly(['schemaVersion','matchId','clubId','tournamentId','eventId','seasonId','roundNumber','courtNumber','teamA','teamB','teamAPlayerIds','teamBPlayerIds','playerIds','scoreA','scoreB','status','validatedByUid','validatedAt','revision'])
              && data.schemaVersion == 2 && data.matchId == matchId
              && data.clubId == clubId && data.tournamentId == tournamentId
              && data.roundNumber is int && data.courtNumber is int
              && data.teamA is list && data.teamA.size() == 2
              && data.teamB is list && data.teamB.size() == 2
              && data.teamAPlayerIds is list && data.teamAPlayerIds.size() <= 2
              && data.teamBPlayerIds is list && data.teamBPlayerIds.size() <= 2
              && data.playerIds == data.teamAPlayerIds.concat(data.teamBPlayerIds)
              && data.scoreA is int && data.scoreB is int
              && data.scoreA >= 0 && data.scoreA <= 99 && data.scoreB >= 0 && data.scoreB <= 99
              && data.scoreA != data.scoreB && data.status == 'validated';
          }
          allow get: if activeMember(clubId)
            || (registeredAccount() && currentPlayerId() in resource.data.playerIds);
          allow list: if activeMember(clubId)
            || (registeredAccount() && currentPlayerId() in resource.data.playerIds);
          allow create: if activeMember(clubId) && validOfficialMatch(request.resource.data)
            && request.resource.data.validatedByUid == request.auth.uid;
          allow update: if activeMember(clubId) && validOfficialMatch(request.resource.data)
            && request.resource.data.clubId == resource.data.clubId
            && request.resource.data.tournamentId == resource.data.tournamentId
            && request.resource.data.matchId == resource.data.matchId
            && request.resource.data.validatedByUid == request.auth.uid
            && request.resource.data.revision == resource.data.revision + 1;
          allow delete: if false;
        }

        match /auditLog/{auditId} {
          allow read: if activeMember(clubId);
          allow create: if activeMember(clubId)
            && request.resource.data.clubId == clubId
            && request.resource.data.tournamentId == tournamentId
            && request.resource.data.auditId == auditId
            && request.resource.data.actorUid == request.auth.uid;
          allow update, delete: if false;
        }

        match /roundSummaries/{roundNumber} {
          function validRoundSummary(data) {
            return data.keys().hasOnly(['schemaVersion','clubId','tournamentId','eventId','seasonId','roundNumber','byePlayerIds','validatedByUid','validatedAt'])
              && data.schemaVersion == 2 && data.clubId == clubId && data.tournamentId == tournamentId
              && data.roundNumber is int && data.roundNumber >= 1 && data.byePlayerIds is list
              && data.validatedByUid == request.auth.uid;
          }
          allow read: if activeMember(clubId);
          allow create, update: if activeMember(clubId) && validRoundSummary(request.resource.data);
          allow delete: if false;
        }

        match /matchTimers/{matchId} {
          allow read: if activeMember(clubId);
          // Schéma réservé : fermé jusqu'à l'implémentation explicite du timer individuel.
          allow create, update, delete: if false;
        }
      }
    }

    match /tournaments/{code} {
      // Le code public permet uniquement la lecture exacte du tournoi.
      allow get: if isValidCode(code);
      allow list: if false;

      // Tout organisateur peut créer un tournoi, mais il en devient l'unique
      // propriétaire et ne peut publier que le schéma Viewer compact.
      allow create: if isValidCode(code)
        && request.auth != null
        && ((request.resource.data.schemaVersion < 4 && request.resource.data.ownerUid == request.auth.uid)
          || (request.resource.data.schemaVersion in [4, 5]
            && activeMember(request.resource.data.clubId)
            && request.resource.data.ownerUid == get(/databases/$(database)/documents/clubs/$(request.resource.data.clubId)).data.ownerUid))
        && hasValidPublicShape(request.resource.data, code);

      // Connaître le code ou posséder une autre identité Firebase ne donne
      // aucun droit. Le propriétaire et le schéma ne peuvent pas être changés.
      allow update: if request.auth != null
        && ((resource.data.schemaVersion < 4 && resource.data.ownerUid == request.auth.uid)
          || (resource.data.schemaVersion in [4, 5] && activeMember(resource.data.clubId)))
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.code == resource.data.code
        && request.resource.data.revision > resource.data.revision
        && hasValidPublicShape(request.resource.data, code);

      allow delete: if request.auth != null
        && ((resource.data.schemaVersion < 4 && resource.data.ownerUid == request.auth.uid)
          || (resource.data.schemaVersion in [4, 5] && clubAdmin(resource.data.clubId)));

      match /viewerSessions/{uid} {
        allow get: if request.auth != null && request.auth.uid == uid;
        allow list: if false;
        allow create: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['playerId', 'createdAt'])
          && request.resource.data.playerId is int
          && request.resource.data.playerId >= 0
          && request.resource.data.createdAt is int
          && request.resource.data.playerId < get(/databases/$(database)/documents/tournaments/$(code)).data.players.size();
        allow update, delete: if false;
      }

      match /scoreProposals/{proposalId} {
        function proposalTournament() {
          return get(/databases/$(database)/documents/tournaments/$(code)).data;
        }
        function proposalSession() {
          return get(/databases/$(database)/documents/tournaments/$(code)/viewerSessions/$(request.auth.uid)).data;
        }
        function validProposal(data) {
          return data.keys().hasOnly(['schemaVersion','proposalId','publicCode','clubId','tournamentId','roundNumber','courtNumber','proposedByUid','proposedByParticipantId','engineIndex','scoreA','scoreB','status','createdAt','updatedAt'])
            && data.schemaVersion == 2 && data.proposalId == proposalId && data.publicCode == code
            && data.clubId == proposalTournament().clubId
            && data.roundNumber == proposalTournament().roundNumber
            && data.courtNumber is int && data.courtNumber >= 1
            && data.courtNumber <= proposalTournament().currentRound.courts.size()
            && data.engineIndex == proposalSession().playerId
            && proposalTournament().schemaVersion == 5
            && data.proposedByParticipantId == proposalTournament().participantIds[data.engineIndex]
            && (data.engineIndex in proposalTournament().currentRound.courts[data.courtNumber - 1].teamA
              || data.engineIndex in proposalTournament().currentRound.courts[data.courtNumber - 1].teamB)
            && data.proposedByUid == request.auth.uid
            && data.scoreA is int && data.scoreA >= 0 && data.scoreA <= 99
            && data.scoreB is int && data.scoreB >= 0 && data.scoreB <= 99
            && data.scoreA != data.scoreB && data.status == 'pending';
        }
        function proposalOrganizer() {
          return request.auth != null && proposalTournament().schemaVersion in [4, 5]
            && activeMember(proposalTournament().clubId);
        }
        allow get: if request.auth != null && (resource.data.proposedByUid == request.auth.uid || proposalOrganizer());
        allow list: if proposalOrganizer();
        allow create: if request.auth != null
          && exists(/databases/$(database)/documents/tournaments/$(code)/viewerSessions/$(request.auth.uid))
          && validProposal(request.resource.data);
        allow update: if proposalOrganizer()
          && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
          && request.resource.data.status in ['accepted','rejected'];
        allow delete: if false;
      }

      match /courtTimers/{timerId} {
        // Ancien format par terrain : lecture conservée pendant la migration,
        // mais toute nouvelle écriture est fermée.
        allow get, list: if isValidCode(code);
        allow create, update, delete: if false;
      }

      match /roundTimer/{timerId} {
        function tournament() {
          return get(/databases/$(database)/documents/tournaments/$(code)).data;
        }
        function organizer() {
          return request.auth != null
            && ((tournament().schemaVersion < 4 && tournament().ownerUid == request.auth.uid)
              || (tournament().schemaVersion in [4, 5] && activeMember(tournament().clubId)));
        }
        function validCommon(data) {
          return timerId == 'current'
            && data.keys().hasOnly([
              'state', 'roundNumber', 'durationMinutes', 'roundStartedAt',
              'startedBy', 'viewerStartConsumed', 'generation', 'updatedAt'
            ])
            && tournament().endMode == 'time'
            && data.roundNumber == tournament().roundNumber
            && data.durationMinutes == tournament().roundDurationMinutes
            && data.generation is int
            && data.generation >= 0
            && data.viewerStartConsumed is bool
            && data.updatedAt is timestamp
            && data.updatedAt == request.time;
        }
        function validRunning(data) {
          return validCommon(data)
            && data.state == 'running'
            && data.roundStartedAt is timestamp
            && data.roundStartedAt == request.time
            && data.viewerStartConsumed == true
            && (data.startedBy == 'organizer' || data.startedBy is int);
        }
        function validIdle(data) {
          return validCommon(data)
            && data.state == 'idle'
            && data.roundStartedAt == null
            && data.startedBy == null;
        }
        allow get, list: if isValidCode(code);
        allow create: if
          (organizer()
            && validIdle(request.resource.data)
            && request.resource.data.generation == 0
            && request.resource.data.viewerStartConsumed == false)
          || (validRunning(request.resource.data)
            && request.resource.data.generation == 1
            && organizer() && request.resource.data.startedBy == 'organizer');
        allow update: if request.resource.data.generation == resource.data.generation + 1
          && (
            // Un seul démarrage est possible pendant un round. La transaction
            // cliente et cette précondition serveur arbitrent les concurrents.
            (resource.data.roundNumber == tournament().roundNumber
              && resource.data.state == 'idle'
              && organizer() && validRunning(request.resource.data)
              && request.resource.data.startedBy == 'organizer')
            // Un nouveau round peut remplacer atomiquement le document précédent.
            || (resource.data.roundNumber < tournament().roundNumber
              && organizer() && validRunning(request.resource.data)
              && request.resource.data.startedBy == 'organizer')
            // Seul l'Organisateur peut remettre le round courant à l'état initial.
            || (organizer()
              && resource.data.roundNumber == tournament().roundNumber
              && resource.data.state == 'running'
              && validIdle(request.resource.data)
              && request.resource.data.viewerStartConsumed == resource.data.viewerStartConsumed)
          );
        allow delete: if false;
      }
    }

    // Lecture d'historique via collectionGroup : uniquement les matchs où le
    // playerId permanent du compte figure explicitement dans le résultat.
    match /{path=**}/matches/{matchId} {
      allow get, list: if registeredAccount()
        && currentPlayerId() in resource.data.playerIds;
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
